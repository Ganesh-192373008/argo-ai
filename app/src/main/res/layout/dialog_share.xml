<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Share Report"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/btnCloseShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Sharing Platform"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select any platform below to share your crop report with farmers, experts, or your community."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Social Media Horizontal List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="📱 Share via Social Media"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap any app to share your report"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/btnShareWhatsApp" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_whatsapp" app:tint="#25D366" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1A25D366" android:padding="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsApp" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Facebook -->
                    <LinearLayout android:id="@+id/btnShareFacebook" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_facebook" app:tint="#1877F2" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1A1877F2" android:padding="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Facebook" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Twitter -->
                    <LinearLayout android:id="@+id/btnShareTwitter" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_twitter" app:tint="#1DA1F2" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1A1DA1F2" android:padding="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Twitter" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Telegram -->
                    <LinearLayout android:id="@+id/btnShareTelegram" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_telegram" app:tint="#0088cc" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1A0088cc" android:padding="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Telegram" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Instagram -->
                    <LinearLayout android:id="@+id/btnShareInstagram" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_instagram" app:tint="#E1306C" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1AE1306C" android:padding="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Instagram" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Messaging -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="💬 Share via Messaging"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Send directly to contacts"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/btnShareEmail" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_email" app:tint="#D44638" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1AD44638" android:padding="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/btnShareSMS" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/sym_action_chat" app:tint="#4CAF50" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#1A4CAF50" android:padding="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMS" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/text_primary"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Other Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="⚙️ Other Options"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnCopyToClipboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_edit" app:tint="#757575"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy to Clipboard" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy report text to paste anywhere" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>
 
                <LinearLayout
                    android:id="@+id/btnMoreApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_more" app:tint="#757575"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More Apps..." android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use system share menu" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Report Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#F5F5F5"
                android:padding="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 Report Preview:"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Crop Disease Detection Result\nEarly Blight detected in my Tomato crop. Confidence: 94%"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- Sharing Tips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#E8F5E9"
                android:padding="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Sharing Tips"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Share with farming communities to help others\n• Send to agricultural experts for advice\n• Each platform has specific instructions to guide you"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
