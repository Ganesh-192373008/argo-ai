<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Fertilizer Schedule"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvTotalSchedules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 total schedules"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Upcoming -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatUpcoming"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:background="#E3F2FD">
                        <TextView android:id="@+id/tvStatUpcomingVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#1565C0" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upcoming" android:textColor="#1976D2" android:textSize="12sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Today -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatToday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:background="#E8F5E9">
                        <TextView android:id="@+id/tvStatTodayVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#2E7D32" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="#388E3C" android:textSize="12sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Missed -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatMissed"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:background="#FFEBEE">
                        <TextView android:id="@+id/tvStatMissedVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#C62828" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Missed" android:textColor="#D32F2F" android:textSize="12sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Missed Alert Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMissedAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:background="#FFF3E0">
                    
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_dialog_alert" app:tint="#E65100"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You have 1 missed schedule(s)!" android:textColor="#E65100" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to view and take action" android:textColor="#EF6C00" android:textSize="12sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View" android:textColor="#E65100" android:textStyle="bold" android:textSize="14sp" android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tabs row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <LinearLayout android:id="@+id/layoutTabUpcoming" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
                        <TextView android:id="@+id/tabUpcoming" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upcoming (1)" android:textColor="@color/text_secondary" android:textSize="14sp" android:paddingVertical="8dp"/>
                        <View android:id="@+id/indicatorUpcoming" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/primary_green" android:visibility="invisible"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layoutTabToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
                        <TextView android:id="@+id/tabToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today (1)" android:textColor="@color/text_secondary" android:textSize="14sp" android:paddingVertical="8dp"/>
                        <View android:id="@+id/indicatorToday" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/primary_green" android:visibility="invisible"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layoutTabMissed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
                        <TextView android:id="@+id/tabMissed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Missed (1)" android:textColor="@color/text_secondary" android:textSize="14sp" android:paddingVertical="8dp"/>
                        <View android:id="@+id/indicatorMissed" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/primary_green" android:visibility="invisible"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layoutTabAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
                        <TextView android:id="@+id/tabAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All (2)" android:textColor="@color/primary_green" android:textStyle="bold" android:textSize="14sp" android:paddingVertical="8dp"/>
                        <View android:id="@+id/indicatorAll" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/primary_green" android:visibility="visible"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
            
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

            <!-- Schedule List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">
                
                <!-- Dynamic Schedule Container -->
                <LinearLayout
                    android:id="@+id/layoutScheduleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Create Schedule Button -->
                <Button
                    android:id="@+id/btnCreateFertilizerSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="@color/app_background"
                    android:text="+ Add Another Schedule"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/primary_green"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

