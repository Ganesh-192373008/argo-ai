<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="8dp"
    android:elevation="8dp">

    <!-- Camera -->
    <LinearLayout
        android:id="@+id/attachCamera"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_chat_camera"
            android:background="@drawable/circle_icon_bg"
            android:backgroundTint="#F5F5F5"
            android:padding="6dp"
            app:tint="#424242"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Camera"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Photos -->
    <LinearLayout
        android:id="@+id/attachPhotos"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_chat_photos"
            android:background="@drawable/circle_icon_bg"
            android:backgroundTint="#F5F5F5"
            android:padding="6dp"
            app:tint="#424242"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Photos"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Files -->
    <LinearLayout
        android:id="@+id/attachFiles"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_chat_files"
            android:background="@drawable/circle_icon_bg"
            android:backgroundTint="#F5F5F5"
            android:padding="6dp"
            app:tint="#424242"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Files"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
