<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F4">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_dark" />
            
        <ImageView
            android:id="@+id/agroAiLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_assistant_bot"
            android:background="@drawable/circle_icon_bg_green"
            android:backgroundTint="#E8F5E9"
            android:padding="8dp"
            app:tint="@color/primary_green"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ask Assistant"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/primary_green"
                    android:alpha="0.7"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Smart Farming Companion"
                android:textColor="@color/primary_green"
                android:textSize="12sp" />
        </LinearLayout>
        
        <ImageView
            android:id="@+id/btnHeaderMic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mic"
            android:padding="8dp"
            app:tint="@color/primary_green" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:padding="8dp"
            app:tint="@color/primary_green"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Chat Conversation Scroll Area -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/suggestionChipsScroll">
        
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>
    </ScrollView>

    <!-- Suggestion Chips Horizontal Scroll View -->
    <HorizontalScrollView
        android:id="@+id/suggestionChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#00000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputArea">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/chipDetectDisease"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Detect Disease"
                android:textSize="13sp"
                android:textColor="@color/primary_green"
                android:background="@drawable/bg_pill_green"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chipTreatmentAdvice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊 Treatment Advice"
                android:textSize="13sp"
                android:textColor="@color/primary_green"
                android:background="@drawable/bg_pill_green"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chipPreventionTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Prevention Tips"
                android:textSize="13sp"
                android:textColor="@color/primary_green"
                android:background="@drawable/bg_pill_green"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chipFertilizerGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 Fertilizer Guide"
                android:textSize="13sp"
                android:textColor="@color/primary_green"
                android:background="@drawable/bg_pill_green"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chipWeatherHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌤️ Weather Help"
                android:textSize="13sp"
                android:textColor="@color/primary_green"
                android:background="@drawable/bg_pill_green"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textStyle="bold"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Sticky Input Area at Bottom -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">
        
        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_attachment"
            app:tint="#757575"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            
            <EditText
                android:id="@+id/chatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_input"
                android:paddingStart="16dp"
                android:paddingEnd="44dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:hint="Ask about crop diseases, treatments, weather..."
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="4"
                android:inputType="textMultiLine"/>

            <ImageView
                android:id="@+id/btnInputMic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/primary_green"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </FrameLayout>
            
        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/circle_icon_bg_green"
            android:backgroundTint="@color/primary_green"
            android:padding="10dp"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout 
            android:id="@+id/navHome" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" app:tint="@color/text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navDetection" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_detect_disease" app:tint="@color/text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detection" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navAssistant" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_assistant_bot" app:tint="@color/primary_green" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assistant" android:textColor="@color/primary_green" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navProfile" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_profile" app:tint="@color/text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
