<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Achievements"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Total Points Widget -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp">
                
                <TextView
                    android:id="@+id/tvTotalPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="285"
                    android:textColor="#F57C00"
                    android:textSize="48sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Points Earned"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Completed Section -->
            <TextView
                android:id="@+id/tvCompletedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/containerCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <!-- In Progress Section -->
            <TextView
                android:id="@+id/tvInProgressHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Progress"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/containerInProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card: First Scan -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFirstScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="🌱" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#E8F5E9"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="First Scan" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complete your first disease detection" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvFirstScanPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 pts" android:textColor="#9E9E9E" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutFirstScanProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:orientation="horizontal" android:weightSum="1" android:background="#EEEEEE">
                                <View android:id="@+id/viewFirstScanProgress" android:layout_width="0dp" android:layout_weight="0" android:layout_height="match_parent" android:background="@color/primary_green"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvFirstScanProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress 0/1" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card: 5 Day Streak -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="🔥" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#FFF3E0"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 Day Streak" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use the app for 5 consecutive days" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvStreakPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25 pts" android:textColor="#9E9E9E" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutStreakProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:orientation="horizontal" android:weightSum="5" android:background="#EEEEEE">
                                <View android:id="@+id/viewStreakProgress" android:layout_width="0dp" android:layout_weight="0" android:layout_height="match_parent" android:background="@color/primary_green"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvStreakProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress 0/5" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card: Early Bird -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEarlyBird"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="🎯" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#E3F2FD"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Early Bird" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detect disease before it spreads" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvEarlyBirdPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50 pts" android:textColor="#9E9E9E" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutEarlyBirdProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:orientation="horizontal" android:weightSum="1" android:background="#EEEEEE">
                                <View android:id="@+id/viewEarlyBirdProgress" android:layout_width="0dp" android:layout_weight="0" android:layout_height="match_parent" android:background="@color/primary_green"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvEarlyBirdProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress 0/1" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card: Knowledge Seeker -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKnowledgeSeeker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="📚" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#F3E5F5"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Knowledge Seeker" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ask 10 questions to AI assistant" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvKnowledgeSeekerPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 pts" android:textColor="#9E9E9E" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutKnowledgeSeekerProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:orientation="horizontal" android:weightSum="10" android:background="#EEEEEE">
                                <View android:id="@+id/viewKnowledgeSeekerProgress" android:layout_width="0dp" android:layout_weight="0" android:layout_height="match_parent" android:background="@color/primary_green"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvKnowledgeSeekerProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress 0/10" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card: Crop Master -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCropMaster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="🌾" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#FFF9C4"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crop Master" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add 5 different crops to profile" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvCropMasterPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20 pts" android:textColor="#9E9E9E" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutCropMasterProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:orientation="horizontal" android:weightSum="5" android:background="#EEEEEE">
                                <View android:id="@+id/viewCropMasterProgress" android:layout_width="0dp" android:layout_weight="0" android:layout_height="match_parent" android:background="@color/primary_green"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvCropMasterProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress 0/5" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card: Top Farmer -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTopFarmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="🏆" android:textSize="24sp" android:gravity="center" android:background="@drawable/circle_icon_bg_green" android:backgroundTint="#FFECB3"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top Farmer" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reach 500 total points" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvTopFarmerPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100 pts" android:textColor="#9E9E9E" android:textStyle="bold" android:textSize="14sp" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutTopFarmerProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:orientation="horizontal" android:weightSum="500" android:background="#EEEEEE">
                                <View android:id="@+id/viewTopFarmerProgress" android:layout_width="0dp" android:layout_weight="0" android:layout_height="match_parent" android:background="@color/primary_green"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvTopFarmerProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress 0/500" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
