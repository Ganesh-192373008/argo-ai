<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Water Management"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water Management Plan"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Save water, save money!"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Daily Watering Schedule"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Morning Schedule -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#E1F5FE">
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌅" android:textSize="24sp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Morning • Deep Watering" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6:00 AM - 8:00 AM" android:textColor="#1976D2" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Best time for thorough watering of vegetables and crops" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Benefits:" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Plants absorb water before heat\n✓ Reduces evaporation loss\n✓ Leaves dry by afternoon\n✓ Prevents fungal diseases" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" android:lineSpacingExtra="2dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water deeply - 2-3 inches of soil" android:textColor="#0277BD" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Afternoon Schedule -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFEBEE">
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌞" android:textSize="24sp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Afternoon • Avoid Watering" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:00 PM - 4:00 PM" android:textColor="#D32F2F" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High evaporation and potential leaf burn from water droplets" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Benefits:" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Conserve water resources\n✓ Prevent scalding of leaves\n✓ Avoid rapid evaporation\n✓ Save effort for better timing" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" android:lineSpacingExtra="2dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emergency only - minimal if needed" android:textColor="#C62828" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Evening Schedule -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F3E5F5">
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌆" android:textSize="24sp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evening • Light Watering" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5:00 PM - 7:00 PM" android:textColor="#7B1FA2" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Supplement if morning watering was insufficient" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Benefits:" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Less evaporation than midday\n✓ Helps plants recover from heat\n✓ Good for container plants\n✓ Refreshes wilted plants" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" android:lineSpacingExtra="2dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light watering - surface level only" android:textColor="#6A1B9A" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Water Saving Techniques -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Water-Saving Techniques"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Technique 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card_white" android:padding="16dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 Drip Irrigation" android:textColor="#1976D2" android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="70% water saving\nWater directly to roots, minimal waste" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Precise water delivery\n• Reduces weed growth\n• Lower disease risk\n• Automated scheduling possible" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Investment: Medium - High returns" android:textColor="#00796B" android:textStyle="italic" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Technique 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card_white" android:padding="16dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌿 Mulching" android:textColor="#388E3C" android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50% evaporation reduction\nOrganic layer retains soil moisture" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Maintains soil temperature\n• Suppresses weed growth\n• Improves soil quality\n• Reduces water frequency" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Investment: Low - Easy to implement" android:textColor="#00796B" android:textStyle="italic" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Technique 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card_white" android:padding="16dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌧️ Rainwater Harvesting" android:textColor="#0288D1" android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Free water resource\nCollect and store rainwater for irrigation" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Zero water cost\n• Naturally soft water\n• Reduces runoff\n• Sustainable practice" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Investment: Medium - Long-term savings" android:textColor="#00796B" android:textStyle="italic" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Technique 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card_white" android:padding="16dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊 Soil Moisture Monitoring" android:textColor="#F57C00" android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30% water optimization\nTrack soil moisture to water only when needed" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Prevents overwatering\n• Data-driven decisions\n• Healthier root development\n• Cost optimization" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginTop="8dp" lineSpacingExtra="2dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Investment: Low - High efficiency" android:textColor="#00796B" android:textStyle="italic" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Crop Water Requirements -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="💧 Crop Water Requirements"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
                
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card_white" android:padding="16dp" android:elevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rice" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1200-1500mm / Very High"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Wheat" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="450-650mm / Medium"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tomato" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="600-800mm / Med-High"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Potato" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500-700mm / Medium"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Onion" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="350-550mm / Low-Med"/></LinearLayout>
            </LinearLayout>

            <!-- Tips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#E1F5FE"
                android:padding="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water Conservation Tips"
                    android:textColor="#0288D1"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Check soil moisture before watering\n• Use mulch to reduce evaporation by up to 50%\n• Water deeply but less frequently for stronger roots\n• Fix leaks in irrigation systems immediately\n• Group plants with similar water needs together"
                    android:textColor="#01579B"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnCreateSchedule"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/primary_green"
                android:text="Create Watering Schedule"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

