<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Custom Plan Generator"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnAction"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Subtitle Intro Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/primary_green"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personalized Plan"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Answer questions for a custom farming plan"
                        android:textColor="#E8F5E9"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Progress Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/textProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progress: 0/5 completed"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressWizard"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="5"
                    android:progress="0"
                    android:progressTint="@color/primary_green"
                    android:progressBackgroundTint="#E0E0E0"/>
            </LinearLayout>

            <!-- Q1: Farm Size -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What is your farm size?"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <RadioGroup
                        android:id="@+id/rgFarmSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbSizeLess1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Less than 1 hectare" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSize1to5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1-5 hectares" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSize5to10" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5-10 hectares" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSizeMore10" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="More than 10 hectares" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Q2: Soil Type -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What is your soil type?"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <RadioGroup
                        android:id="@+id/rgSoilType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbSoilSandy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sandy" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSoilLoamy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loamy" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSoilClay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clay" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSoilSilty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Silty" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbSoilNotSure" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not sure" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Q3: Water Sources -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available water sources?"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <RadioGroup
                        android:id="@+id/rgWaterSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbWaterWell" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Well" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbWaterBorewell" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Borewell" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbWaterCanal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Canal" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbWaterRain" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rainwater only" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbWaterMultiple" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Multiple sources" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Q4: Last Season Crops -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What crops did you grow last season?"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <RadioGroup
                        android:id="@+id/rgLastSeasonCrops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbLastRiceWheat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rice/Wheat" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbLastVeg" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vegetables" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbLastPulses" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pulses" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbLastMixed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mixed crops" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbLastFirstTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="First time farming" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Q5: Target Market -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What is your target market?"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <RadioGroup
                        android:id="@+id/rgTargetMarket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbMarketLocal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local market" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbMarketWholesale" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wholesale" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbMarketDirect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Direct consumers" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbMarketExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Export" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                        <RadioButton android:id="@+id/rbMarketMixed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mixed" android:textColor="@color/text_primary" android:textSize="14sp" android:padding="8dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- What You'll Get Promo Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#EDE7F6">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 What You'll Get"
                        android:textColor="#512DA8"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="• Customized crop rotation schedule\n• Water management recommendations\n• Fertilizer application timeline\n• Disease prevention strategies\n• Market-oriented crop suggestions\n• Seasonal planting calendar"
                        android:textColor="#4527A0"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Done Button -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:backgroundTint="#B0BEC5"
        android:enabled="false"
        android:text="Answer 5 More Questions"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
