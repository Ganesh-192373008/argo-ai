<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/textCropTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Crop Price Details"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">
                
                <TextView 
                    android:id="@+id/textCropEmoji"
                    android:layout_width="80dp" 
                    android:layout_height="80dp" 
                    android:background="@drawable/circle_icon_bg_green" 
                    android:backgroundTint="#FFEBEE" 
                    android:gravity="center" 
                    android:text="🍅" 
                    android:textSize="40sp"/>
                
                <TextView
                    android:id="@+id/textCropPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="₹35/kg"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:id="@+id/textCropChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="+12% this week"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#E8F5E9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Price Trend Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price Trend (Last 5 Days)"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                        
                    <!-- Simulated Graph Area -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:weightSum="5">
                        
                         <!-- Day 1 -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:id="@+id/textDay1Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹31" android:textColor="@color/primary_green" android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                            <View android:id="@+id/viewDay1Bar" android:layout_width="16dp" android:layout_height="60dp" android:background="@color/primary_green"/>
                            <TextView android:id="@+id/textDay1Date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jun 14" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Day 2 -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:id="@+id/textDay2Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹33" android:textColor="@color/primary_green" android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                            <View android:id="@+id/viewDay2Bar" android:layout_width="16dp" android:layout_height="70dp" android:background="@color/primary_green"/>
                            <TextView android:id="@+id/textDay2Date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jun 15" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Day 3 -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:id="@+id/textDay3Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹32" android:textColor="@color/primary_green" android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                            <View android:id="@+id/viewDay3Bar" android:layout_width="16dp" android:layout_height="65dp" android:background="@color/primary_green"/>
                            <TextView android:id="@+id/textDay3Date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jun 16" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Day 4 -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:id="@+id/textDay4Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹34" android:textColor="@color/primary_green" android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                            <View android:id="@+id/viewDay4Bar" android:layout_width="16dp" android:layout_height="75dp" android:background="@color/primary_green"/>
                            <TextView android:id="@+id/textDay4Date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jun 17" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Day 5 -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                            <TextView android:id="@+id/textDay5Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹35" android:textColor="@color/primary_green" android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                            <View android:id="@+id/viewDay5Bar" android:layout_width="16dp" android:layout_height="80dp" android:background="@color/primary_green"/>
                            <TextView android:id="@+id/textDay5Date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jun 18" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nearby Markets Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nearby Markets"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewMandiMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Map 🗺️"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <!-- Market 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/textMarket1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APMC Market, Mumbai" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 km" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:id="@+id/textMarket1Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹35" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:id="@+id/textMarket1Unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="per kg" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                    
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginHorizontal="16dp"/>

                    <!-- Market 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/textMarket2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APMC Market, Pune" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="145 km" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:id="@+id/textMarket2Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹38" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:id="@+id/textMarket2Unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="per kg" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
 
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginHorizontal="16dp"/>

                    <!-- Market 3 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/textMarket3Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mandi, Nashik" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="180 km" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:id="@+id/textMarket3Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹33" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:id="@+id/textMarket3Unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="per kg" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
 
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginHorizontal="16dp"/>

                    <!-- Market 4 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/textMarket4Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agricultural Market, Nagpur" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="820 km" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:id="@+id/textMarket4Price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹32" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:id="@+id/textMarket4Unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="per kg" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
 
                </LinearLayout>
            </androidx.cardview.widget.CardView>
 
            <!-- Insight Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="#FFF8E1"
                android:padding="16dp"
                android:orientation="vertical"
                android:elevation="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Market Insight"
                    android:textColor="#F57F17"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/textMarketInsight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Prices are expected to rise further due to reduced supply. Good time to sell your produce!"
                    android:textColor="#F57F17"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

