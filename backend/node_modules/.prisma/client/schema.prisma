// Prisma Schema for AgroAssist SQL Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @default("Rajesh Kumar")
  age       String   @default("35")
  crops     String   @default("Tomato, Rice, Wheat")
  location  String   @default("Punjab, India")
  gps       Boolean  @default(false)
  email     String?  @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules Schedule[]
  histories DetectionHistory[]
  cropsList TrackedCrop[]
  posts     CommunityPost[]
  comments  CommunityComment[]
  alerts    Notification[]
}

model Schedule {
  id           Int      @id @default(autoincrement())
  userId       Int?
  cropName     String
  scheduleType String // Water or Fertilizer
  detail       String
  date         String
  time         String
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DetectionHistory {
  id         Int      @id @default(autoincrement())
  userId     Int?
  imagePath  String?
  cropName   String
  disease    String
  confidence String
  timestamp  String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackedCrop {
  id                  Int      @id @default(autoincrement())
  userId              Int?
  cropName            String
  plantedDate         String
  expectedHarvestDate String
  createdAt           DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id        Int      @id @default(autoincrement())
  userId    Int?
  avatar    String?
  name      String
  state     String
  time      String
  content   String
  likes     Int      @default(0)
  isLiked   Boolean  @default(false)
  isMyPost  Boolean  @default(false)
  imageUri  String?
  createdAt DateTime @default(now())

  user     User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
}

model CommunityComment {
  id          Int      @id @default(autoincrement())
  postId      Int
  userId      Int?
  avatar      String?
  name        String
  content     String
  time        String
  isMyComment Boolean  @default(false)
  createdAt   DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketPrice {
  id        Int      @id @default(autoincrement())
  cropName  String
  price     String
  unit      String   @default("per Quintal")
  trend     String   @default("UP") // UP, DOWN, STABLE
  location  String   @default("Mandi Central")
  date      String
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  message   String
  type      String   @default("INFO") // INFO, WATER, FERTILIZER, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
